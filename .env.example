# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.

# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000
# URL pública usada no QR code. Vazio = detectar o IP da LAN automaticamente.
# Com túnel Cloudflare, use a URL do túnel (ex.: https://xyz.trycloudflare.com);
# scripts/tunnel-app.sh sobe o túnel e preenche isso automaticamente.
PUBLIC_URL=

# Banco de dados
DB_PATH=data/quiz.db

# Regras do jogo
QUESTION_TIME=20
BASE_POINTS=10
SPEED_BONUS=5
MAX_TEAM_SIZE=3

# Escala e resiliência do servidor (uma única instância/processo)
# Máximo de salas vivas em memória; acima disso, POST /api/rooms responde 503.
MAX_ACTIVE_ROOMS=100
# Salas terminadas ou abandonadas no lobby são removidas após este tempo (minutos).
ROOM_TTL_MINUTES=30
# Timeout por envio a um socket WebSocket; cliente lento não trava a sala (segundos).
WS_SEND_TIMEOUT=2.0
# Intervalo da varredura de limpeza de salas (segundos).
JANITOR_INTERVAL_SECONDS=60

# LLM: offline | gemini | hf | local
LLM_PROVIDER=offline

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face Inference Providers (https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_MODEL=

# Ollama local (https://ollama.com)
# Ollama em outro notebook exposto por túnel Cloudflare: use a URL do túnel
# (ex.: https://xyz.trycloudflare.com). Veja scripts/tunnel-ollama.ps1.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=420
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false
