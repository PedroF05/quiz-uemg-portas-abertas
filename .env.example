# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.

# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000
# URL pública usada no QR code. Vazio = detectar o IP da LAN automaticamente.
PUBLIC_URL=

# Banco de dados
DB_PATH=data/quiz.db

# Regras do jogo
QUESTION_TIME=20
BASE_POINTS=10
SPEED_BONUS=5
MAX_TEAM_SIZE=3

# LLM: offline | gemini | hf | local
LLM_PROVIDER=offline

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face Inference Providers (https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_MODEL=

# Ollama local (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=180
